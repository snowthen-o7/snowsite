---
import Layout from '../../layouts/Layout.astro';

const projects = [
  {
    slug: 'ecommerce-postman',
    title: 'E-Commerce API Collections',
    description: 'Comprehensive Postman collections for Shopify GraphQL, BigCommerce, WooCommerce, and more. CI/CD integration with Newman.',
    tags: ['Postman', 'Shopify', 'BigCommerce', 'WooCommerce', 'CI/CD'],
    featured: true
  },
  {
    slug: 'data-diff-checker',
    title: 'Data Diff Checker',
    description: 'CSV regression testing tool for API workflows. Catches breaking feed changes before they hit production.',
    tags: ['Python', 'Async', 'Testing', 'E-commerce']
  },
  {
    slug: 'snowpipe',
    title: 'SnowPipe',
    description: 'SaaS platform for syncing product catalogs across Shopify, WooCommerce, Google Merchant, Meta, and Square.',
    tags: ['Next.js', 'tRPC', 'PostgreSQL', 'Shopify', 'ETL'],
    external: 'https://pipe.snowforge.dev'
  },
  {
    slug: 'watchruneterra',
    title: 'WatchRuneterra',
    description: 'League of Legends analytics platform with Bloomberg Terminal-inspired UI',
    tags: ['Next.js', 'PostgreSQL', 'TimescaleDB', 'Redis']
  }
];
---

<Layout title="Portfolio" description="Selected projects and case studies" wide>
  <h1>Portfolio</h1>
  
  <p class="intro">
    E-commerce integrations, data tools, and platforms I've built.
  </p>

  <div class="projects">
    {projects.map(project => (
      <a href={project.external || `/portfolio/${project.slug}`} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined} class:list={['project-card', { featured: project.featured }]}>
        <h2>{project.title} {project.external && <span class="external-icon">↗</span>}</h2>
        <p>{project.description}</p>
        <div class="tags">
          {project.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  h1 {
    margin-bottom: 1rem;
  }

  .intro {
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 700px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    display: block;
    padding: 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: all 0.15s ease;
  }

  .project-card:hover {
    background: var(--bg-hover);
    border-color: var(--accent);
  }

  .project-card.featured {
    border-color: var(--accent-dim);
  }

  .project-card h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .external-icon {
    font-size: 0.85rem;
    color: var(--accent);
  }

  .project-card p {
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
  }
</style>
