---
import Layout from '../../layouts/Layout.astro';

const freeTools = [
  {
    title: 'CSV Toolkit',
    description: 'Compare, merge, deduplicate, and transform CSV files. All processing happens in your browser.',
    href: '/tools/csv-toolkit',
    icon: '',
    status: 'live' as const,
  },
  {
    title: 'Webhook Inspector',
    description: 'Capture, inspect, and debug incoming webhooks in real-time. Perfect for API development.',
    href: '/tools/webhook-inspector',
    icon: '',
    status: 'live' as const,
  },
];

const paidTools = [
  {
    title: 'Meta Commerce Catalog MCP',
    description: 'Connect AI assistants to Meta\'s Commerce Catalog API. Validate feeds, debug disapprovals, and manage product catalogs through natural language.',
    href: '#',
    icon: '',
    status: 'coming-soon' as const,
    distribution: 'MCPize',
  },
  {
    title: 'Shopify Bulk Catalog MCP',
    description: 'Handle Shopify bulk operations (JSONL) correctly at scale. Built-in timeout handling and presentment price optimization.',
    href: '#',
    icon: '',
    status: 'coming-soon' as const,
    distribution: 'MCPize',
  },
  {
    title: 'Multi-Channel Feed Validator MCP',
    description: 'Validate product feeds against Google, Meta, and TikTok specs before they break your ads.',
    href: '#',
    icon: '',
    status: 'coming-soon' as const,
    distribution: 'MCPize',
  },
];

const tools = [...freeTools, ...paidTools];
---

<Layout title="Developer Tools" description="E-commerce developer tools: CSV comparison, webhook debugging, MCP servers for Shopify, Meta, and more." wide>
  <div class="tools-page">
    <header class="hero">
      <h1>Developer Tools</h1>
      <p class="subtitle">Tools for e-commerce data, feeds, and API work</p>
    </header>

    <h2 class="section-title">Free Tools</h2>
    <div class="tools-list">
      {freeTools.map((tool) => (
        <a href={tool.href} class="tool-card">
          <span class="tool-icon">{tool.icon}</span>
          <div class="tool-content">
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
          </div>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>

    <h2 class="section-title">MCP Servers <span class="badge accent">New</span></h2>
    <p class="section-desc">AI-powered tools for e-commerce workflows. Connect these to Claude, Cursor, or any MCP-compatible client.</p>
    <div class="tools-list">
      {paidTools.map((tool) => (
        <div class="tool-card disabled">
          <span class="tool-icon">{tool.icon}</span>
          <div class="tool-content">
            <h2>{tool.title} <span class="badge">{tool.distribution}</span></h2>
            <p>{tool.description}</p>
          </div>
          <span class="badge coming">Coming Soon</span>
        </div>
      ))}
    </div>

    <section class="cta">
      <h2>Need a Custom Tool?</h2>
      <p>I build data processing and integration tools for e-commerce businesses.</p>
      <a href="/contact" class="cta-button">Get in Touch</a>
    </section>
  </div>
</Layout>

<style>
  .tools-page {
    max-width: 100%;
  }

  .hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .hero h1 {
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .tools-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }

  .tool-card:hover:not(.disabled) {
    border-color: var(--accent);
    background: var(--bg-hover);
  }

  .tool-card.disabled {
    opacity: 0.6;
    cursor: default;
  }

  .tool-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .tool-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .tool-content h2 {
    font-size: 1.1rem;
    margin: 0 0 0.25rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tool-content p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.5;
  }

  .section-title {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 4px;
  }

  .badge.accent {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .badge.coming {
    border-color: var(--accent-dim);
    color: var(--accent-dim);
    flex-shrink: 0;
  }

  .arrow {
    font-size: 1.25rem;
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .tool-card:hover:not(.disabled) .arrow {
    transform: translateX(4px);
  }

  .cta {
    text-align: center;
    padding: 2rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .cta h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
  }

  .cta p {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .cta-button {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .cta-button:hover {
    background: var(--text);
    color: var(--bg);
  }

  @media (max-width: 600px) {
    .tool-card {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .arrow {
      display: none;
    }

    .tool-content h2 {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>
